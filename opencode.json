{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3.1-pro-preview",
  "instructions": ["AGENTS.md"],
  "permission": {
    "read": {
      "**": "allow",
      "**/.env*": "deny",
      "**/*secret*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "../**": "deny"
    },
    "edit": {
      "**": "allow",
      "**/.env*": "deny",
      "../**": "deny"
    },
    "bash": {
      "ls*": "allow",
      "dir*": "allow",
      "cd *": "allow",
      "pwd": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "cat *": "allow",
      "mv *": "allow",
      "cp *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add*": "allow",
      "git commit*": "allow",

      "cat **/.env*": "deny",
      "grep **/.env*": "deny",
      "head **/.env*": "deny",
      "tail **/.env*": "deny",
      "source **/.env*": "deny",
      "git push --force*": "deny",
      "rm -rf /": "deny",
      "rm -rf ~": "deny",

      "*": "ask"
    }
  }
}
